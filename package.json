{
  "name": "agentreceipt",
  "version": "0.1.2",
  "description": "Make your coding agent show a receipt before it says \"done\": a Stop hook for Codex and Claude Code that runs your tests, checks the git diff, and sends the agent back to work if they fail.",
  "bin": {
    "agentreceipt": "bin/agentreceipt.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mulanxizhizi-png/agentreceipt.git"
  },
  "keywords": [
    "codex",
    "claude-code",
    "coding-agent",
    "ai-agent",
    "hooks",
    "stop-hook",
    "testing",
    "verification",
    "receipt",
    "cli"
  ],
  "author": "Zjing (https://github.com/mulanxizhizi-png)",
  "homepage": "https://agentreceipt.netlify.app",
  "bugs": {
    "url": "https://github.com/mulanxizhizi-png/agentreceipt/issues"
  }
}
